{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ppt-paper-club",
  "compatibility_date": "2026-09-01",
  // Static site only: no Worker script, Cloudflare serves ./dist directly.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Wrangler creates the hostname and its DNS record on deploy.
  "routes": [
    {
      "pattern": "ppt.karneeshkar.tech",
      "custom_domain": true
    }
  ]
}
